# Server Configuration
PORT=3000

# Razorpay API Keys
# Obtain these from: Razorpay Dashboard → Settings → API Keys
# Use rzp_test_... keys for development, rzp_live_... for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Webhook Secret
# Obtain from: Razorpay Dashboard → Webhooks → your webhook → Secret
# This is DIFFERENT from RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
